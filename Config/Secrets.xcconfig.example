// 复制为 Secrets.local.xcconfig，填入网盘开放平台的应用凭据
// 阿里云盘：https://www.alipan.com/developer （回调地址填 mp9://oauth/aliyun）
MP9_ALIYUN_CLIENT_ID = your_client_id
MP9_ALIYUN_CLIENT_SECRET =
// 百度网盘：https://pan.baidu.com/union （回调地址填 mp9://oauth/baidu）
MP9_BAIDU_CLIENT_ID = your_app_key
MP9_BAIDU_CLIENT_SECRET = your_secret_key
