// 复制为 Secrets.local.xcconfig，填入网盘开放平台的应用凭据
// 阿里云盘：https://www.alipan.com/developer （回调地址填 amplayer://oauth/aliyun）
AMP_ALIYUN_CLIENT_ID = your_client_id
AMP_ALIYUN_CLIENT_SECRET =
// 百度网盘：https://pan.baidu.com/union （回调地址填 amplayer://oauth/baidu）
AMP_BAIDU_CLIENT_ID = your_app_key
AMP_BAIDU_CLIENT_SECRET = your_secret_key
